{
  "compilerOptions": {
    "outDir": "./dist/cdk",
    "baseUrl": ".",
    "paths": {
      "/opt/nodejs/*": ["layers/common/*"],
      "aws-lambda": ["node_modules/@types/aws-lambda"]
    },
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "aws-lambda"]
  },
  "include": ["stacks", "lambdas/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "layers/common/node_modules", "cdk.out", "dist"]
}
